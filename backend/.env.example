# Smart Traffic Management System (STMS) Environment Configuration
NODE_ENV=development
PORT=5000

# MongoDB URI: If local MongoDB is not running, the application will automatically 
# initialize an embedded MongoDB Memory Server for immediate demonstration.
MONGODB_URI=mongodb://localhost:27017/smart_traffic

# Set to true to force in-memory database (useful when testing without local MongoDB)
USE_IN_MEMORY_DB=auto

# Security & Authentication
JWT_SECRET=stms_super_secure_jwt_secret_key_college_project_2026!
JWT_EXPIRES_IN=24h

# Demo & Simulation Settings
SIMULATION_INTERVAL_MS=10000
AUTO_SIMULATION_ENABLED=true

# Congestion Threshold Defaults
THRESHOLD_NORMAL_MAX_VEHICLES=20
THRESHOLD_NORMAL_MIN_SPEED=40
THRESHOLD_MODERATE_MAX_VEHICLES=39
THRESHOLD_MODERATE_MIN_SPEED=25
THRESHOLD_HEAVY_MAX_VEHICLES=59
THRESHOLD_HEAVY_MIN_SPEED=15
THRESHOLD_SEVERE_MIN_VEHICLES=60
